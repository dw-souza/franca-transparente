# Copie para .env e ajuste. O .env nunca vai para o git.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=franca
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=franca_transparencia
POSTGRES_PORT=5432
# Para rodar collector/API fora do Docker (o compose sobrescreve com host "db")
DATABASE_URL=postgresql://franca:troque-esta-senha@localhost:5432/franca_transparencia

# ---------------------------------------------------------------- Escopo
CODIGO_IBGE=3516200
# CNPJs de órgãos consultados em /v1/contratos (separados por vírgula).
# Os que aparecerem nas contratações do município são somados automaticamente.
# Confirmados no PNCP (out/2026): 47970769000104 Prefeitura · 49219538000180 Câmara Municipal
# · 54157748000121 Faculdade de Direito de Franca · 47987136000109 Centro Universitário Municipal (Uni-FACEF)
# · 07339703000198 FEAC (Fundação Esporte, Arte e Cultura) · 45310125000156 SASSOM (previdência dos servidores).
# Acrescente outras autarquias e fundos quando confirmados.
ORGAOS_CNPJ=47970769000104,49219538000180,54157748000121,47987136000109,07339703000198,45310125000156

# ---------------------------------------------------------------- PNCP
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
# Vazio = todas as modalidades (1-13). Ex.: 6,8,9 = pregão eletrônico, dispensa, inexigibilidade
PNCP_MODALIDADES=
PNCP_JANELA_DIAS=30

# ---------------------------------------------------------------- HTTP (seja educado com as fontes)
HTTP_USER_AGENT="PainelTransparenciaFranca/0.1 (+https://github.com/dw-souza/franca-transparente; contato@exemplo.org)"
HTTP_DELAY_SEGUNDOS=0.5
HTTP_TIMEOUT_SEGUNDOS=30
HTTP_RETRIES=5

# ---------------------------------------------------------------- IA (fase 2: resumos e extração do DOMF)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- API (Go) e Web (Next.js)
API_PORT=8080
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
